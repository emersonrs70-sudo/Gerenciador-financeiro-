{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name of the user"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp ISO string"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp ISO string"
        }
      },
      "required": ["email", "name"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial income or expense transaction",
      "type": "object",
      "properties": {
        "descricao": {
          "type": "string",
          "maxLength": 250,
          "description": "Description of the transaction"
        },
        "valor": {
          "type": "number",
          "description": "Monetary value of the transaction"
        },
        "data": {
          "type": "string",
          "maxLength": 30,
          "description": "Date of transaction in YYYY-MM-DD format"
        },
        "categoria": {
          "type": "string",
          "maxLength": 80,
          "description": "Category name"
        },
        "tipoItem": {
          "type": "string",
          "enum": ["despesa", "receita"],
          "description": "Expense or income"
        },
        "accountId": {
          "type": "string",
          "maxLength": 80,
          "description": "Associated bank account ID"
        },
        "faturaMes": {
          "type": "string",
          "maxLength": 20,
          "description": "Invoice month reference for credit card purchases"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase user ID who owns this transaction"
        },
        "created_at": {
          "type": "string",
          "maxLength": 50,
          "description": "Creation timestamp ISO string"
        }
      },
      "required": ["descricao", "valor", "data", "categoria", "tipoItem", "userId"]
    },
    "Project": {
      "title": "Project",
      "description": "Financial goal or dream project",
      "type": "object",
      "properties": {
        "nome": {
          "type": "string",
          "maxLength": 120,
          "description": "Project title or goal name"
        },
        "valor": {
          "type": "number",
          "description": "Target monetary goal"
        },
        "dataAlvo": {
          "type": "string",
          "maxLength": 30,
          "description": "Target date in YYYY-MM-DD format"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase user ID"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50,
          "description": "Creation timestamp"
        }
      },
      "required": ["nome", "valor", "dataAlvo", "userId"]
    },
    "Category": {
      "title": "Category",
      "description": "Custom transaction category",
      "type": "object",
      "properties": {
        "nome": {
          "type": "string",
          "maxLength": 80,
          "description": "Category name"
        },
        "tipo": {
          "type": "string",
          "enum": ["despesa", "receita"],
          "description": "Category type"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase user ID"
        }
      },
      "required": ["nome", "tipo", "userId"]
    },
    "BankAccount": {
      "title": "BankAccount",
      "description": "Bank account or credit card configuration",
      "type": "object",
      "properties": {
        "nome": {
          "type": "string",
          "maxLength": 80,
          "description": "Bank or account name"
        },
        "tipo": {
          "type": "string",
          "enum": ["corrente", "credito", "poupanca", "investimento"],
          "description": "Account type"
        },
        "saldoInicial": {
          "type": "number",
          "description": "Starting balance"
        },
        "cor": {
          "type": "string",
          "maxLength": 50,
          "description": "Badge color CSS class"
        },
        "limiteCredito": {
          "type": "number",
          "description": "Credit limit for credit cards"
        },
        "diaFechamento": {
          "type": "number",
          "description": "Closing day of billing cycle"
        },
        "diaVencimento": {
          "type": "number",
          "description": "Payment due day"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase user ID"
        }
      },
      "required": ["nome", "tipo", "saldoInicial", "userId"]
    },
    "RecurrentRule": {
      "title": "RecurrentRule",
      "description": "Recurring transaction generation rule",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Rule identifier"
        },
        "descricao": {
          "type": "string",
          "maxLength": 250,
          "description": "Transaction description to generate"
        },
        "valor": {
          "type": "number",
          "description": "Monetary value"
        },
        "diaDoMes": {
          "type": "number",
          "description": "Day of the month for execution (1-31)"
        },
        "categoria": {
          "type": "string",
          "maxLength": 80,
          "description": "Category name"
        },
        "tipoItem": {
          "type": "string",
          "enum": ["despesa", "receita"],
          "description": "Expense or income"
        },
        "accountId": {
          "type": "string",
          "maxLength": 80,
          "description": "Associated bank account ID"
        },
        "ativa": {
          "type": "boolean",
          "description": "Whether recurring rule is active"
        },
        "criadaEm": {
          "type": "string",
          "maxLength": 50,
          "description": "Creation timestamp ISO string"
        },
        "ultimoMesGerado": {
          "type": "string",
          "maxLength": 20,
          "description": "Last generated month code e.g. 2026-10"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase user ID"
        }
      },
      "required": ["descricao", "valor", "diaDoMes", "categoria", "tipoItem"]
    },
    "PendingSuggestion": {
      "title": "PendingSuggestion",
      "description": "Incoming bank notification pending approval",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique suggestion ID"
        },
        "rawText": {
          "type": "string",
          "maxLength": 500,
          "description": "Original notification text"
        },
        "banco": {
          "type": "string",
          "maxLength": 80,
          "description": "Bank or institution name"
        },
        "descricao": {
          "type": "string",
          "maxLength": 250,
          "description": "Parsed transaction description"
        },
        "valor": {
          "type": "number",
          "description": "Monetary transaction value"
        },
        "tipoItem": {
          "type": "string",
          "enum": ["despesa", "receita"],
          "description": "Expense or income"
        },
        "categoria": {
          "type": "string",
          "maxLength": 80,
          "description": "Suggested category"
        },
        "accountId": {
          "type": "string",
          "maxLength": 80,
          "description": "Suggested bank account ID"
        },
        "data": {
          "type": "string",
          "maxLength": 30,
          "description": "Date in YYYY-MM-DD format"
        },
        "status": {
          "type": "string",
          "enum": ["pendente", "aprovada", "descartada"],
          "description": "Approval status"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase user ID"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50,
          "description": "Timestamp ISO string"
        }
      },
      "required": ["descricao", "valor", "tipoItem", "status", "userId"]
    },
    "IncomingNotification": {
      "title": "IncomingNotification",
      "description": "Incoming bank notifications pushed from mobile automation like MacroDroid",
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 1000,
          "description": "Notification content body"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Notification title"
        },
        "app": {
          "type": "string",
          "maxLength": 100,
          "description": "Originating banking app package or name"
        },
        "timestamp": {
          "type": "string",
          "maxLength": 50,
          "description": "Timestamp string"
        }
      },
      "required": ["text"]
    }
  },
  "firestore": {
    "/incoming_notifications/{notifId}": {
      "schema": "IncomingNotification",
      "description": "Buffer collection for incoming mobile push notifications"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "User financial transactions"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "Project",
      "description": "User financial goals and dreams"
    },
    "/users/{userId}/categories/{categoryId}": {
      "schema": "Category",
      "description": "User custom categories"
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": "BankAccount",
      "description": "User bank accounts"
    },
    "/users/{userId}/recurrent_rules/{ruleId}": {
      "schema": "RecurrentRule",
      "description": "User recurring transaction automation rules"
    },
    "/users/{userId}/pending_suggestions/{suggestionId}": {
      "schema": "PendingSuggestion",
      "description": "User pending bank notification suggestions"
    }
  }
}
